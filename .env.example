# Local MySQL service from docker-compose.yml
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow

# Local profile and CORS. Keep TASKFLOW_COOKIE_SECURE=true in HTTPS Preview/production.
SPRING_PROFILES_ACTIVE=dev
TASKFLOW_COOKIE_SECURE=false
TASKFLOW_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Development only: seeds sample users/tasks once on an empty local database.
TASKFLOW_SEED_DEMO=true
TASKFLOW_DEMO_PASSWORD=TaskFlowDemo2026!
